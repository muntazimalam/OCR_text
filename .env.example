APP_NAME="Intelligent Media Processing Pipeline"
APP_VERSION="1.0.0"
DEBUG=true

# Defaults to SQLite if unset. Set to PostgreSQL only when a server is available:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/media_pipeline"
# IMPORTANT for Render (free tier): the instance disk is EPHEMERAL — SQLite
# data is erased on every restart. Point DATABASE_URL at a managed PostgreSQL
# database so records (images, analyses, visitor visits) survive restarts.
REDIS_URL="redis://localhost:6379/0"

UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10
